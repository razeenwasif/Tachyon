# Tachyon configuration
#
# Copy to %APPDATA%\Tachyon\tachyon.conf
#
# Format is `dotted.key = value`, one per line. `#` starts a comment unless it
# begins a colour literal. Unknown keys and out-of-range values are reported in
# a dialog on startup rather than being silently ignored.

# ---------------------------------------------------------------------------
# Font
# ---------------------------------------------------------------------------

font.family      = "Cascadia Mono"
font.size        = 12.0

# Programming ligatures (-> != |>) in fonts that have them, such as Cascadia
# Code, Fira Code and JetBrains Mono. Cascadia Mono has none, by design.
# font.ligatures = true

# subpixel  - ClearType-style RGB coverage, sharpest on a normal desktop LCD
# grayscale - single-channel coverage; use on rotated or non-RGB-stripe panels
font.antialias   = subpixel

# Blending gamma. 1.0 is physically linear; a little above renders stems fuller,
# which most people prefer for terminal text. Range 0.5 - 3.0.
font.gamma       = 1.2

# Stem darkening applied to coverage before blending. Lifts the low end so
# antialiased edges do not disappear against a dark background. Range 0.0 - 1.0.
font.contrast    = 0.15

# Multipliers on the font's natural metrics.
font.line_height = 1.0
font.cell_width  = 1.0

# Use the family's real bold/italic faces. Turn off to keep a single face.
font.bold        = true
font.italic      = true

# ---------------------------------------------------------------------------
# Window
# ---------------------------------------------------------------------------

window.cols      = 120
window.rows      = 32
window.padding_x = 8.0
window.padding_y = 6.0

# What's behind the terminal's background.
#
#   glass    macOS: Liquid Glass behind the text (the Mac default). Text, the
#            cursor, the selection and colours a program sets stay solid; only
#            the default background lets the glass through. With Reduce
#            Transparency on in System Settings, the window is opaque.
#   none     opaque (the Windows default)
#
#   Windows only:
#   acrylic  live blur of the windows behind this one -- "frosted glass"
#   blur     the same, without acrylic's noise and tint (cheaper)
#   mica     tinted from the desktop wallpaper; calm, and it does not shimmer
#   tabbed   mica's slightly more opaque variant
#
# On Windows, a backdrop switches antialiasing to grayscale, because subpixel
# coverage cannot be blended correctly against a background the compositor
# chooses after we have drawn.
# window.backdrop = glass

# macOS: edge (the default) puts the grid right at the top, with the window
# buttons appearing at the top-left corner on hover; standard shows a title bar
# on the glass, with the tabs in it when there are two or more. View > Show
# Title Bar switches while Tachyon runs.
# window.layout = edge

# macOS: what full screen means. native is macOS's own (below the notch);
# notch makes the green button, Ctrl-Cmd-F and View > Enter Full Screen go
# around the notch (tabs left of it, status right, every row below), and
# Tachyon opens that way. Option-Cmd-F goes around the notch either way.
# window.fullscreen = native

# macOS: Liquid Glass's style. clear (the default) is less frosted and bends
# more of what's behind at its edges; regular frosts it more and adapts its
# tint to what's behind.
# window.glass = clear

# macOS: how strongly the glass itself is tinted with the theme's background,
# 0 to 1. The tint colours the glass and keeps its refraction, so it's the way
# to make the window darker (or lighter, in Light Mode) without flattening it.
# window.glass_tint = 0.75

# How opaque the default background drawn over the backdrop is. Defaults to
# 0.05 on Liquid Glass, where the tint above does the work, 0.82 with a Windows
# backdrop, 1.0 without. Text is always fully opaque regardless.
# window.opacity = 0.05

# ---------------------------------------------------------------------------
# Rendering
# ---------------------------------------------------------------------------

# Synchronise presentation to the display refresh. Turning this off permits
# tearing in exchange for the lowest possible latency, on adapters that support
# it.
render.vsync           = true

# macOS: in a window, give each frame to the compositor as soon as it is drawn
# instead of at the next refresh, about half a frame sooner on screen. The
# compositor still syncs to the display, so nothing tears. In full screen,
# render.vsync applies.
# render.low_latency   = true

# 0 means "follow the display refresh".
render.max_fps         = 0

# How long to hold a synchronised-output batch (mode 2026) before drawing
# anyway, in milliseconds. Guards against an application that starts a batch and
# never ends it.
render.sync_timeout_ms = 150

# ---------------------------------------------------------------------------
# Theme
# ---------------------------------------------------------------------------

# macOS: which theme to use. auto follows Light and Dark Mode, switching as the
# system does; dark and light fix one.
# theme.appearance = auto

# macOS: high-contrast versions of both themes, derived from them: a black (or
# white) background, every ANSI colour at 7:1 contrast or better, and a solid
# selection; the glass becomes a solid background. auto follows System
# Settings > Accessibility > Display > Increase Contrast; high and normal fix it.
# theme.contrast = auto

# The dark theme (and the only one on Windows). On macOS, the light theme has
# its own keys, theme.light.background, theme.light.ansi1 and so on, with
# built-in defaults: near-white paper and ANSI colours dark enough to read on it.
theme.background     = #0B0E14
theme.foreground     = #C4CBD8
theme.cursor         = #7DF9C4
theme.cursor_text    = #0B0E14
theme.selection_bg   = #2A3A52
# theme.selection_fg = #FFFFFF

# macOS: `accent` takes the cursor colour, or tints the selection, from the
# system accent colour in System Settings > Appearance, in both themes.
# theme.cursor       = accent
# theme.selection_bg = accent

# Render SGR-bold text with the bright palette variant of its colour.
theme.bold_is_bright = false

# Palette slots 0-15. Anything not set keeps the built-in default.
# theme.ansi0  = #14181F
# theme.ansi1  = #F2606B
# theme.ansi2  = #6FD08C
# theme.ansi3  = #E8C16B
# theme.ansi4  = #63A8F0
# theme.ansi5  = #B084EB
# theme.ansi6  = #5ED2D8
# theme.ansi7  = #C4CBD8
# theme.ansi8  = #465062
# theme.ansi9  = #FF7A85
# theme.ansi10 = #89E8A6
# theme.ansi11 = #FFD985
# theme.ansi12 = #82BFFF
# theme.ansi13 = #C99CFF
# theme.ansi14 = #7AECF2
# theme.ansi15 = #E8EEF7

# ---------------------------------------------------------------------------
# macOS
# ---------------------------------------------------------------------------

# Which Option keys act as Meta, sending ESC + key (what zsh and bash bind
# ⌥B/⌥F word motion to): false, left, right, or true for both. With false,
# Option types the keyboard layout's special characters, as in other Mac apps.
# A common choice is `left`, which keeps right Option for characters like é.
# macos.option_as_meta = false

# A command that runs at least this many seconds and finishes while you're in
# another app or window posts a notification with its receipt; clicking it
# brings its tab to the front. 0 turns notifications off.
# notify.after = 10

# ---------------------------------------------------------------------------
# Shell
# ---------------------------------------------------------------------------

# Leave empty to pick the best available: pwsh, then powershell, then %COMSPEC%.
# shell.program = "C:\\Program Files\\PowerShell\\7\\pwsh.exe"
# shell.args    = "-NoLogo"
#
# For WSL:
# shell.program = "wsl.exe"

# Load Tachyon's shell integration into zsh (prompt and command marks for the
# gutter, run receipts and Cmd-Up/Down). Your .zshrc is not modified.
# shell.integration = true

# macOS: run shells in Tachyon's session host, so quitting, crashing or
# updating Tachyon leaves them running and reopening it puts them back, with
# their windows, tabs, splits and screens. Option-Cmd-Q quits and ends them;
# closing a window or tab ends its shells as usual.
# shell.persist = true

# macOS: as you type at a prompt, the rest of a command you've run before, in
# grey; Right arrow or End takes it, Option-Right one word. From your shell's
# history and every command run in Tachyon (~/Library/Application
# Support/Tachyon/history, private to you).
# shell.suggestions = true

# macOS: a band along the bottom with shortcut hints (and Fairy's button at its
# right end). false gives the row back to the grid.
# window.hints = true

# macOS: Fairy, the assistant on this Mac: a button at the bottom right (and
# Option-Cmd-I) opens a card where she answers about what's on the screen. She
# listens on a private socket in her data folder; fairy.socket points elsewhere.
# fairy.enabled = true
# fairy.socket = ~/Library/Application Support/lyra-companion/lyra/tachyon.sock

# Lines of scrollback retained above the viewport.
scrollback = 10000
